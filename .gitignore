# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Test / tooling
.pytest_cache/
.coverage
htmlcov/

# macOS
.DS_Store
node_modules/

# IDE
.vscode/
.idea/

# Per-user agent tooling state (local permission allowlist, session worktrees). The shared
# settings.json, hooks, agents and skills in the same folder stay tracked.
/.claude/settings.local.json
/.claude/worktrees/

# InodeFence runtime data
findings/private/*
!findings/private/.gitkeep

corpus/generated/
experiments/results/

# Experiment runtime output
experiments/raw/*
!experiments/raw/.gitkeep
!experiments/raw/README.md

# Generated artifacts
artifacts/
# Legacy in-repo staging dir of scripts/regenerate_paper_artifacts.py (now stages to a temp dir)
.paper-artifacts-stage/

# Local environment / secrets
.env
.env.*
!.env.example

# uv run이 생성하는 lock(런타임 의존성 없음, dev 도구만) — 실험 게이트의 clean-tree 검사를 오염시키지 않도록 무시
uv.lock
